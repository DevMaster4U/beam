# Beam node environment (orchestrator, worker, validator)
# Copy to `.env` and adjust. Never commit `.env`.
#
# Public Beam endpoints:
# CORE_SERVER_URL      -> Beam control plane
# ORCH_GATEWAY_URL     -> BeamCore NATS orchestrator control endpoint

# =============================================================================
# MAINNET
# =============================================================================
CORE_SERVER_URL=https://beamcore.b1m.ai
ORCH_GATEWAY_URL=tls://orch-gateway.b1m.ai:4222
# Optional: SNI override when connecting via IP or alternate DNS
# ORCH_GATEWAY_TLS_SERVER_NAME=orch-gateway.b1m.ai

SUBTENSOR_NETWORK=finney
NETUID=105

# =============================================================================
# WORKER (single instance — use root .env)
# =============================================================================
# Multiple workers: config/workers/<name>.env + ./scripts/run-worker.sh
# Full template: config/workers/worker1.env.example
#
# WORKER_WALLET_NAME=beam
# WORKER_WALLET_HOTKEY=beam_1
# WORKER_GATEWAY_URL=https://your-orchestrator.example.com
# WORKER_GATEWAY_SECRET=your-long-random-worker-secret
#
# WORKER_MAX_CONCURRENT_TASKS=4
# WORKER_MAX_QUEUED_WS_TASKS=4
# WORKER_MAX_IN_FLIGHT_BYTES=268435456
# WORKER_TASK_RESULT_ACK_TIMEOUT=45.0
#
# Byte-range cache (hit=slice+upload, miss=fetch+store+merge, files ≤1 GiB):
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
# WORKER_PREDEFINED_ETAG_BOOTSTRAP_MAX_DOWNLOADS=0
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_URL=http://YOUR_CONTROL_SERVER:8010
# CONTROL_SERVER_SECRET=change-me-control-secret

# =============================================================================
# ORCHESTRATOR
# =============================================================================
# Multiple orchs: config/orchestrators/<name>.env + ./scripts/run-orchestrator.sh
# Templates: orch1.env.example, orch2-embedded.env.example, orch2-in-process.env.example
#
# WALLET_NAME=orchestrator
# WALLET_HOTKEY=default
# API_PORT=9000
# READY=true
# ORCHESTRATOR_WORKER_GATEWAY_URL=https://your-orchestrator.example.com
# WORKER_GATEWAY_SECRET=your-long-random-worker-secret
# WORKER_GATEWAY_MODE=in_process
#
# Embedded workers (set cache vars on orch env):
# WORKER_1=wallet:hotkey
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
#
# Relay tracing:
# ORCH_RELAY_SLOW_LOG_MS=1000.0
# LOG_LEVEL=INFO

# SLACK_NOTIFICATION_URL=https://hooks.slack.com/services/...
# BEAM_VALIDATOR_LOG_LEVEL=INFO
