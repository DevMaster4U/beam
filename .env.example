# Beam node environment (orchestrator, worker, validator)
# Copy to `.env` and adjust. Never commit `.env`.
#
# Public Beam endpoints:
# CORE_SERVER_URL      -> Beam control plane
# ORCH_GATEWAY_URL     -> orchestrator WebSocket gateway
# WORKER_GATEWAY_URL   -> public worker WebSocket gateway

# =============================================================================
# MAINNET
# =============================================================================
CORE_SERVER_URL=https://beamcore.b1m.ai
ORCH_GATEWAY_URL=https://orch-gateway.b1m.ai
WORKER_GATEWAY_URL=https://public-worker-gateway.b1m.ai

SUBTENSOR_NETWORK=finney
NETUID=105

# =============================================================================
# WORKER (single instance — use root .env)
# =============================================================================
# Multiple workers on one machine: use config/workers/<name>.env + scripts/run-worker.sh
# (see docs/worker.md). Each instance needs a unique WORKER_WALLET_HOTKEY.
#
# WORKER_WALLET_NAME=beam
# WORKER_WALLET_HOTKEY=beam_1
#
# Set false for bandwidth proof only (no on-chain payment row).
# WORKER_REQUIRED_PAYMENT=true
#
# Required for dedicated worker-gateway (Option 1); not used on public gateway.
# WORKER_GATEWAY_WORKER_SECRET=your-long-random-worker-secret
#
# WORKER_MAX_CONCURRENT_TASKS=4
# WORKER_MAX_QUEUED_WS_TASKS=4
# WORKER_MAX_IN_FLIGHT_BYTES=268435456

# =============================================================================
# ORCHESTRATOR
# =============================================================================
# Multiple orchestrators on one machine: use config/orchestrators/<name>.env + scripts/run-orchestrator.sh
# (see deploy/systemd/README.md). Each instance needs a unique WALLET_HOTKEY and API_PORT.
#
# WALLET_NAME=orchestrator
# WALLET_HOTKEY=default
# WALLET_PATH=~/.bittensor/wallets
# READY=true

# Option 2 (default): shared public worker gateway
# WORKER_GATEWAY_MODE=public

# Option 1: orchestrator-owned gateway (see docs/worker-gateway.md)
# Multiple gateways on one machine: use config/gateways/<name>.env + scripts/run-worker-gateway.sh
# WORKER_GATEWAY_MODE=dedicated
# WORKER_GATEWAY_PUBLIC_URL=https://your-worker-gateway.example.com
# WORKER_GATEWAY_CONTROL_URL=ws://localhost:8001/control
# WORKER_GATEWAY_CONTROL_SECRET=your-long-random-control-secret
# WORKER_GATEWAY_WORKER_SECRET=your-long-random-worker-secret
# GATEWAY_PORT=8001

# LOG_LEVEL=INFO
#
# Optional Slack incoming webhook for worker/task lifecycle alerts (orchestrator only).
# SLACK_NOTIFICATION_URL=https://hooks.slack.com/services/...


# BEAM_VALIDATOR_LOG_LEVEL=INFO
