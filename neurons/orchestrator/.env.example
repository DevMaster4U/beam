# In-process worker gateway: workers connect to /ws/{worker_id} on API_PORT.
# For multi-instance deploy, prefer config/orchestrators/<name>.env.example

ORCHESTRATOR_WORKER_GATEWAY_URL=https://your-orchestrator.example.com
WORKER_GATEWAY_SECRET=your-long-random-worker-secret
READY=true

WALLET_NAME=orchestrator
WALLET_HOTKEY=default
WALLET_PATH=~/.bittensor/wallets
API_PORT=9000

# WORKER_GATEWAY_MODE=in_process
# ORCH_GATEWAY_URL=tls://orch-gateway.b1m.ai:4222
# CORE_SERVER_URL=https://beamcore.b1m.ai

# Embedded / hybrid cache vars (if using WORKER_N):
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_SECRET=change-me-control-secret
# Orch listens for range coverage (segments only) and routes misses to
# WORKER_NON_CACHED_FILE=true workers. Set ORCH_COVERAGE_ROUTING=false to disable.
# ORCH_COVERAGE_ROUTING=true
# ORCH_DOWNLOAD_RANGE_DATA=false

# Optional Cloudflare transfer for embedded predefined-etag offers:
#   WORKER_N_CF_TRANSFER_ENABLED=true|false  → per embedded worker (preferred)
#   CF_TRANSFER_ENABLED=true|false           → default when WORKER_N unset
# CF_TRANSFER_WORKER_URLS=https://cf-w1.workers.dev,https://cf-w2.workers.dev
# CF_TRANSFER_WORKER_TIMEOUT=120
# CF_TRANSFER_SEND_ACCEPT=false
# WORKER_1_CF_TRANSFER_ENABLED=true

LOG_LEVEL=INFO
