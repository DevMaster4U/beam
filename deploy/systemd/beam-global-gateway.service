[Unit]
Description=BEAM Global Worker Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BEAM_USER@
Group=@BEAM_GROUP@
WorkingDirectory=@BEAM_ROOT@/global-gateway
Environment="PATH=@BEAM_VENV@/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=@BEAM_ROOT@/global-gateway"
Environment="LOG_DIR=@BEAM_ROOT@/logs"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-@BEAM_ROOT@/config/global-gateway.env
ExecStart=@BEAM_VENV@/bin/python @BEAM_ROOT@/global-gateway/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Application logs go to ${LOG_DIR}/global-gateway/global-gateway.log
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
