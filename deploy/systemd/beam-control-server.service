[Unit]
Description=BEAM Control Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BEAM_USER@
Group=@BEAM_GROUP@
WorkingDirectory=@BEAM_ROOT@/control-server
Environment="PATH=@BEAM_VENV@/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=@BEAM_ROOT@"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-@BEAM_ROOT@/config/control-server.env
ExecStart=@BEAM_VENV@/bin/python @BEAM_ROOT@/control-server/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
