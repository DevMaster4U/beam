[Unit]
Description=BEAM Worker (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BEAM_USER@
Group=@BEAM_GROUP@
WorkingDirectory=@BEAM_ROOT@/neurons/worker
Environment="PATH=@BEAM_VENV@/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LOG_DIR=@BEAM_ROOT@/logs"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-@BEAM_ROOT@/.env
EnvironmentFile=-@BEAM_ROOT@/config/workers/%i.env
ExecStart=@BEAM_VENV@/bin/python @BEAM_ROOT@/neurons/worker/worker.py --env-file @BEAM_ROOT@/config/workers/%i.env
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Application logs go to ${LOG_DIR}/workers/%i.log.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
