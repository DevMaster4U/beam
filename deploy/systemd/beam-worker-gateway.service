[Unit]
Description=BEAM Worker Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BEAM_USER@
Group=@BEAM_GROUP@
WorkingDirectory=@BEAM_ROOT@/worker-gateway
Environment="PATH=@BEAM_VENV@/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-@BEAM_ROOT@/.env
ExecStart=@BEAM_VENV@/bin/python @BEAM_ROOT@/worker-gateway/main.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=append:@BEAM_ROOT@/logs/gateway.log
StandardError=append:@BEAM_ROOT@/logs/gateway.log

[Install]
WantedBy=multi-user.target
