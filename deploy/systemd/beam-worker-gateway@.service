[Unit]
Description=BEAM Worker Gateway (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BEAM_USER@
Group=@BEAM_GROUP@
WorkingDirectory=@BEAM_ROOT@/worker-gateway
Environment="PATH=@BEAM_VENV@/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LOG_DIR=@BEAM_ROOT@/logs"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-@BEAM_ROOT@/.env
EnvironmentFile=-@BEAM_ROOT@/config/gateways/%i.env
ExecStart=@BEAM_VENV@/bin/python @BEAM_ROOT@/worker-gateway/main.py --env-file @BEAM_ROOT@/config/gateways/%i.env
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=append:@BEAM_ROOT@/logs/gateways/%i.log
StandardError=append:@BEAM_ROOT@/logs/gateways/%i.log

[Install]
WantedBy=multi-user.target
