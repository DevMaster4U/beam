[Unit]
Description=BEAM Orchestrator (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BEAM_USER@
Group=@BEAM_GROUP@
WorkingDirectory=@BEAM_ROOT@/neurons/orchestrator
Environment="PATH=@BEAM_VENV@/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=@BEAM_ROOT@"
Environment="LOG_DIR=@BEAM_ROOT@/logs"
Environment="ORCHESTRATOR_INSTANCE=%i"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-@BEAM_ROOT@/.env
EnvironmentFile=-@BEAM_ROOT@/config/orchestrators/%i.env
# Fix root-owned logs/cache left by `sudo … --foreground`.
ExecStartPre=+/bin/mkdir -p @BEAM_ROOT@/logs/orchestrators @BEAM_ROOT@/logs/workers/predefined_etag_range_data/.tmp @BEAM_ROOT@/logs/workers/predefined_etag_chunk_data
ExecStartPre=+/bin/chown -R @BEAM_USER@:@BEAM_GROUP@ @BEAM_ROOT@/logs/orchestrators @BEAM_ROOT@/logs/workers
ExecStart=@BEAM_VENV@/bin/python @BEAM_ROOT@/neurons/orchestrator/main.py --env-file @BEAM_ROOT@/config/orchestrators/%i.env
Restart=always
RestartSec=5
TimeoutStopSec=30

# Application logs go to ${LOG_DIR}/orchestrators/%i.log.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
