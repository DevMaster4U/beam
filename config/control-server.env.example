# Control server — copy to control-server.env and adjust.
# Install:
#   sudo ./scripts/install-systemd.sh --enable
#   sudo ./scripts/install-systemd.sh --enable-control-server
#   ./scripts/run-control-server.sh start

CONTROL_SERVER_HOST=0.0.0.0
CONTROL_SERVER_PORT=8010
CONTROL_SERVER_SECRET=css

# Stored data (miners/*.env, cache/predefined_etag_chunks.json, wallets/*)
CONTROL_SERVER_DATA_DIR=/root/subnets/sn105/data/control-server

# Miners connect with:
#   CONTROL_SERVER_URL=http://<this-host>:8010
#   CONTROL_SERVER_SECRET=change-me-control-secret
#   CONTROL_SERVER_MINER_ID=miner1
