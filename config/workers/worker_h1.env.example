# External worker — connects to orchestrator in_process gateway.
# Copy to config/workers/worker_h1.env and adjust.
# Full comments: config/workers/worker1.env.example
#
# Run:
#   ./scripts/run-worker.sh worker_h1 --foreground

WORKER_WALLET_NAME=beam-w2
WORKER_WALLET_HOTKEY=beam-w2h
# WALLET_NAME / WALLET_HOTKEY also accepted as aliases

WORKER_GATEWAY_URL=http://your-orchestrator-host:9003
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

WORKER_MAX_CONCURRENT_TASKS=1
WORKER_TASK_RESULT_ACK_TIMEOUT=45.0

# Byte-range cache: hit → upload from range_data; miss → fetch/store/merge (≤1 GiB)
WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
WORKER_PREDEFINED_ETAG_BOOTSTRAP_MAX_DOWNLOADS=0

# Optional shared control-server (unset to disable):
CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
CONTROL_SERVER_URL=http://YOUR_CONTROL_SERVER:8010
CONTROL_SERVER_SECRET=change-me-control-secret
CONTROL_SERVER_MINER_ID=worker_h1
