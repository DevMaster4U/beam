# Per-worker settings for instance "worker1".
# Copy to config/workers/worker1.env and adjust.
# Run: ./scripts/run-worker.sh worker1
#
# Shared network settings (CORE_SERVER_URL, SUBTENSOR_NETWORK) load from
# workspace .env unless overridden here.

# =============================================================================
# Identity (unique hotkey per worker; must be registered on subnet 105)
# =============================================================================
WORKER_WALLET_NAME=beam
WORKER_WALLET_HOTKEY=beam_1
# WALLET_PATH=~/.bittensor/wallets

# =============================================================================
# Worker gateway (NOT BeamCore)
# =============================================================================
# Match orchestrator ORCHESTRATOR_WORKER_GATEWAY_URL (in_process / embedded)
# or the shared global gateway URL (global / coordinator).
WORKER_GATEWAY_URL=https://your-orchestrator.example.com
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

# =============================================================================
# Concurrency — see docs/worker.md
# Helper: ./scripts/tune-worker-host.sh --link-mbps 100 --workers 2
# =============================================================================
WORKER_MAX_CONCURRENT_TASKS=2
WORKER_MAX_QUEUED_WS_TASKS=2
WORKER_MAX_IN_FLIGHT_BYTES=134217728

# Result relay (BeamCore task_result_ack). Accept/reject protocol is removed.
WORKER_TASK_RESULT_ACK_TIMEOUT=45.0
# WORKER_TASK_RESULT_SEND_ATTEMPTS=8
# WORKER_EARLY_TRANSFER=true

# Round-robin tie-break when idle (active=0): higher value preferred first.
# WORKER_INITIAL_ORDER=0

# =============================================================================
# Byte-range cache (predefined-etag / continuous range_data)
# =============================================================================
# Flow per task:
#   hit  → slice from local range_data → upload to dest
#   miss → download + upload → ingest (merge + pack ≤1 GiB files)
#
# Local store:  logs/workers/predefined_etag_range_data/<sha256(source)[:32]>/
# Metadata:     logs/workers/predefined_etag_chunks.json
# Cap:          RANGE_DATA_MAX_SEGMENT_BYTES (default 1073741824 = 1 GiB)

WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
WORKER_PREDEFINED_ETAG_MAX_PARALLEL=1
# Cache hit pre-submit: md5 etag from file → task_result → background PUT.
# Miss/original: etag from PUT response only (no local etag calc for submit).
# WORKER_COMPUTE_CHUNK_HASH=false  # optional sha256 on task_result (default false)
# WORKER_VERIFY_CHUNK_HASH=true    # false = ignore expected chunk_hash mismatch checks
# WORKER_PREDEFINED_ETAG_MAX_SPEED_MBPS=450
# WORKER_PREDEFINED_ETAG_MIN_SUBMIT_SEC=0

# Do NOT mass-download cache on control-server WS connect (keeps idle RAM low).
WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
WORKER_PREDEFINED_ETAG_BOOTSTRAP_MAX_DOWNLOADS=0

# Optional env override for one known source (prefix match; query stripped).
# WORKER_PREDEFINED_ETAG_SOURCE_URL=https://example.r2.cloudflarestorage.com/bucket/file.bin
# WORKER_PREDEFINED_ETAG_SOURCE_FILE_SIZE=10737418240
# WORKER_PREDEFINED_ETAG_CHUNK_HASH=<sha256 hex>
# WORKER_PREDEFINED_ETAG_ETAG="etag-value"

# Shared control-server cache (optional). Unset all to disable.
# WS = metadata broadcast; HTTP = range GET/PUT for bytes.
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_URL=http://YOUR_CONTROL_SERVER:8010
# CONTROL_SERVER_SECRET=change-me-control-secret
# CONTROL_SERVER_MINER_ID=miner1
# CONTROL_SERVER_CACHE_SYNC_DELAY_SEC=150

# RANGE_DATA_MAX_SEGMENT_BYTES=1073741824

# =============================================================================
# Prewarm (skipped automatically on predefined-etag fast path)
# =============================================================================
# WORKER_PREWARM_ENABLED=true
# WORKER_PREWARM_TIMEOUT=5
# WORKER_PREWARM_ORIGINS=https://bucket.s3.amazonaws.com
