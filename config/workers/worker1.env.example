# Per-worker settings for instance "worker1".
# Copy to config/workers/worker1.env and adjust.
#
# Shared network settings (CORE_SERVER_URL, SUBTENSOR_NETWORK)
# are loaded from the workspace .env unless overridden here.

# Unique hotkey per worker (each must be registered on subnet 105).
WORKER_WALLET_NAME=beam
WORKER_WALLET_HOTKEY=beam_1

# Worker gateway — orchestrator in-process OR shared global gateway (not BeamCore).
# In-process: match orchestrator ORCHESTRATOR_WORKER_GATEWAY_URL
# Global:     http://your-global-gateway-host:8005
WORKER_GATEWAY_URL=https://your-orchestrator.example.com
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

# Concurrency — see docs/worker.md "Host tuning (BBR + concurrency)".
# Helper: ./scripts/tune-worker-host.sh --link-mbps 100 --workers 2
WORKER_MAX_CONCURRENT_TASKS=2
WORKER_MAX_QUEUED_WS_TASKS=2
WORKER_MAX_IN_FLIGHT_BYTES=134217728

# Offer handling — see config/workers/performance.env.example
WORKER_EARLY_TRANSFER=true
WORKER_TASK_ACCEPT_ACK_TIMEOUT=8.0
WORKER_TASK_RESULT_ACK_TIMEOUT=45.0

# HTTP prewarm: learned origins persist in config/workers/<instance>.prewarm-hosts.json
# WORKER_PREWARM_ENABLED=true
# WORKER_PREWARM_ORIGINS=https://bucket.s3.amazonaws.com

# Round-robin tie-break when idle (active=0): higher value is selected first.
# When active>=1, workers rank by observed transfer Mbps instead.
# WORKER_INITIAL_ORDER=0

# Predefined ETag fast path — see config/workers/predefined-etag-fastpath.env.example
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# WORKER_PREDEFINED_ETAG_MAX_SPEED_MBPS=0
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_SECRET=change-me-control-secret
# CONTROL_SERVER_MINER_ID=miner1
