# Simple-worker sample (minimal).
# Prefer: ./scripts/setup-simple-worker.sh --server ec2 --gateway ... --control-server ...
# Or: cp this file to config/workers/worker_h1.env then run-worker.sh
#
# Deps: pip install -r neurons/worker/requirements-simple.txt
# Code: neurons/worker/simple_worker.py
# Orch registers/submits as WORKER_S (see orch2-embedded-global.env.example).

WORKER_HIDDEN=true
WORKER_INSTANCE=worker_h1

# Orchestrator gateway
WORKER_GATEWAY_URL=http://your-orchestrator-host:9003
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

# Control-server cache
CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
CONTROL_SERVER_SECRET=change-me-control-secret
CONTROL_SERVER_MINER_ID=worker_h1
