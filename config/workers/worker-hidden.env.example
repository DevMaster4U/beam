# Hidden overflow worker — connects directly to orchestrator WS (not global-gateway).
# Copy to config/workers/hidden1.env and adjust.
#
# Orchestrator: task_accept + task_result use embedded worker id.
# This host: transfer_offer only, same cache logic as embedded (control-server).
#
# Run:
#   cp config/workers/worker-hidden.env.example config/workers/hidden1.env
#   # edit hidden1.env (orchestrator URL, secrets, control-server)
#   ./scripts/run-worker.sh hidden1
#   ./scripts/run-worker.sh hidden1 --foreground   # debug

WORKER_HIDDEN=true
# Optional stable id (defaults to env filename stem, e.g. hidden1)
# WORKER_INSTANCE=hidden1

# Orchestrator worker gateway (same host as ORCHESTRATOR_WORKER_GATEWAY_URL)
WORKER_GATEWAY_URL=http://your-orchestrator-host:9003
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

WORKER_MAX_CONCURRENT_TASKS=1
WORKER_MAX_QUEUED_WS_TASKS=1

WORKER_EARLY_TRANSFER=true
WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true

# Shared predefined-etag cache (required — same as embedded/orchestrator fleet)
CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
CONTROL_SERVER_SECRET=change-me-control-secret
CONTROL_SERVER_MINER_ID=miner1
# Hidden worker waits for sync_done before connecting to orchestrator gateway
# CONTROL_SERVER_SYNC_DONE_TIMEOUT_SEC=300

# Optional: prefetch cache without running the worker
# ./scripts/fetch-cache-data.sh config/workers/hidden1.env
