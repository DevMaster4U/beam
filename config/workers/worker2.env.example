# Per-worker settings for instance "worker2".
# Copy to config/workers/worker2.env and adjust.

WORKER_WALLET_NAME=beam
WORKER_WALLET_HOTKEY=beam_2

# Worker gateway — orchestrator in-process OR shared global gateway.
WORKER_GATEWAY_URL=https://your-orchestrator.example.com
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

# Concurrency — see docs/worker.md; run: ./scripts/tune-worker-host.sh
WORKER_MAX_CONCURRENT_TASKS=2
WORKER_MAX_QUEUED_WS_TASKS=2
WORKER_MAX_IN_FLIGHT_BYTES=134217728

WORKER_EARLY_TRANSFER=true
# 30 MiB staging fast path (all required):
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# WORKER_PREDEFINED_ETAG_SOURCE_URL=https://ef88e61230a7f9cdaa979b6268878856.r2.cloudflarestorage.com/beam-xfer-test/source/b1m_test/bin10GB.bin
# WORKER_PREDEFINED_ETAG_SOURCE_FILE_SIZE=10737418240
# WORKER_PREDEFINED_ETAG_MIN_SUBMIT_SEC=0
WORKER_TASK_ACCEPT_ACK_TIMEOUT=8.0
WORKER_TASK_RESULT_ACK_TIMEOUT=45.0

# Round-robin tie-break when idle (active=0): higher value is selected first.
# WORKER_INITIAL_ORDER=0

# WORKER_REQUIRED_PAYMENT=false
