# Per-worker settings for instance "worker2".
# Copy to config/workers/worker2.env and adjust.

WORKER_WALLET_NAME=beam
WORKER_WALLET_HOTKEY=beam_2

# In-process worker gateway — must match orchestrator ORCHESTRATOR_WORKER_GATEWAY_URL.
WORKER_GATEWAY_URL=https://your-orchestrator.example.com
WORKER_GATEWAY_WORKER_SECRET=your-long-random-worker-secret

# Concurrency — see docs/worker.md; run: ./scripts/tune-worker-host.sh
WORKER_MAX_CONCURRENT_TASKS=2
WORKER_MAX_QUEUED_WS_TASKS=2
WORKER_MAX_IN_FLIGHT_BYTES=134217728

# WORKER_REQUIRED_PAYMENT=false
