# Optional offer-handling + connection prewarm.
# Copy relevant lines into config/workers/<instance>.env

WORKER_EARLY_TRANSFER=true
# Accept/reject protocol removed — only task_result ack remains:
WORKER_TASK_RESULT_ACK_TIMEOUT=45.0

# Warm DNS/TLS before transfers (helps when tasks arrive every 30–60 min).
# Skipped automatically on predefined-etag fast path.
WORKER_PREWARM_ENABLED=true
WORKER_PREWARM_TIMEOUT=5
WORKER_PREWARM_MAX_ORIGINS=32
# WORKER_PREWARM_ORIGINS=https://account.r2.cloudflarestorage.com

# Cache / range_data (see worker1.env.example):
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
# WORKER_PREDEFINED_ETAG_BOOTSTRAP_MAX_DOWNLOADS=0
