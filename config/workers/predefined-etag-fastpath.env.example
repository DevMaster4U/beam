# Predefined ETag fast path — copy into each config/workers/workerN.env
# (embedded mode: put the same vars in config/orchestrators/orchN.env instead)

WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# 0 = no upload rate limit (fastest cached R2). >0 = cap Mbps.
WORKER_PREDEFINED_ETAG_MAX_SPEED_MBPS=0
# Max concurrent fast-path downloads per worker process.
WORKER_PREDEFINED_ETAG_MAX_PARALLEL=2

# Optional: restrict to one source object (prefix match on offer source URL).
# WORKER_PREDEFINED_ETAG_SOURCE_URL=https://ef88e61230a7f9cdaa979b6268878856.r2.cloudflarestorage.com/beam-xfer-test/source/test10gb-random.bin
# WORKER_PREDEFINED_ETAG_SOURCE_FILE_SIZE=10737418240

# Shared chunk metadata + .bin files via control-server WebSocket broadcast:
CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
CONTROL_SERVER_SECRET=change-me-control-secret
CONTROL_SERVER_MINER_ID=miner1
# Optional HTTP bootstrap (derived from WS URL if omitted):
# CONTROL_SERVER_URL=http://YOUR_CONTROL_SERVER:8010

WORKER_PREWARM_ENABLED=false
