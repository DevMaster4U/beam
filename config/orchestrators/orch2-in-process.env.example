# Orchestrator: in_process gateway + optional embedded WORKER_N (hybrid).
# Copy to orch2.env and adjust.
# Run: ./scripts/run-orchestrator.sh orch2
#
# Flow:
#   - External workers connect via /ws/{worker_id}?api_key=...&worker_secret=...
#   - Optional WORKER_N runs in-process
#   - Hybrid dispatch: prefer fresh-IP embedded, then fresh-IP external, then reuse
#   - Cache: local range_data; optional control-server sync
#
# External worker env: config/workers/worker1.env.example

WALLET_NAME=beam-1
WALLET_HOTKEY=beam-1h
API_PORT=9003
READY=true

ORCH_GATEWAY_URL=tls://orch-gateway.b1m.ai:4222
CORE_SERVER_URL=https://beamcore.b1m.ai

WORKER_GATEWAY_MODE=in_process
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

# Optional in-process embedded worker (omit for external-only)
# WORKER_1=beam-w1:beam-w1h
# WORKER_1_MAX_CONCURRENT_TASKS=1

# Public worker gateway URL (external workers connect here — not 127.0.0.1)
ORCHESTRATOR_WORKER_GATEWAY_URL=http://your-orchestrator-host:9003

# Byte-range cache (applies to embedded WORKER_N; external workers use their own env)
WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
WORKER_PREDEFINED_ETAG_MAX_PARALLEL=2
WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
WORKER_PREDEFINED_ETAG_BOOTSTRAP_MAX_DOWNLOADS=0

# Optional shared control-server:
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_SECRET=change-me-control-secret
# CONTROL_SERVER_MINER_ID=miner1
# CONTROL_SERVER_URL=http://YOUR_CONTROL_SERVER:8010
