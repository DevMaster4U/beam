# Orchestrator with embedded worker + hidden overflow workers (direct WS)
# Copy to orch2.env and adjust.
# Run: ./scripts/run-orchestrator.sh orch2
#
# Flow:
#   - 1st task: local embedded WORKER_1 (max 1 concurrent)
#   - 2nd+ task: hidden worker on same orchestrator WS (task_accept uses embedded id)
#   - Hidden workers connect to THIS orchestrator (not global-gateway)
#
# Hidden workers: config/workers/worker-hidden.env.example

WALLET_NAME=beam-1
WALLET_HOTKEY=beam-1h
API_PORT=9003
READY=true

ORCH_GATEWAY_URL=https://orch-gateway.b1m.ai
CORE_SERVER_URL=https://beamcore.b1m.ai

WORKER_GATEWAY_MODE=embedded_global
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

# Local embedded worker (1 task at a time)
WORKER_1=beam-w1:beam-w1h
WORKER_1_MAX_CONCURRENT_TASKS=1

# Advertised worker gateway URL (orchestrator HTTP — hidden workers connect here)
ORCHESTRATOR_WORKER_GATEWAY_URL=http://84.32.220.100:9003

ORCH_WS_REQUEST_TIMEOUT=15.0
ORCH_TASK_ACCEPT_TIMEOUT=8.0
ORCH_TASK_RESULT_TIMEOUT=30.0

# Predefined ETag cache (embedded + hidden workers via control-server)
WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
WORKER_PREDEFINED_ETAG_MAX_PARALLEL=2
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_SECRET=change-me-control-secret
# CONTROL_SERVER_MINER_ID=miner1
