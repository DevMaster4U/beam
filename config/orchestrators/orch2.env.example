# Per-orchestrator settings for instance "orch2".
# Copy to config/orchestrators/orch2.env and adjust.

CORE_SERVER_URL=https://beamcore.b1m.ai
ORCH_GATEWAY_URL=tls://orch-gateway.b1m.ai:4222
SUBTENSOR_NETWORK=finney
NETUID=105

WALLET_NAME=orchestrator
WALLET_HOTKEY=orch2
API_PORT=9001

ORCHESTRATOR_WORKER_GATEWAY_URL=https://your-orchestrator-2.example.com
WORKER_GATEWAY_SECRET=your-long-random-worker-secret-orch2

# Optional: skip slow subtensor bootstrap when UID is known
# ORCHESTRATOR_UID=123

READY=true
LOG_LEVEL=INFO
