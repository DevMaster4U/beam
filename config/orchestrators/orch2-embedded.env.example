# Orchestrator with embedded workers.
# Copy to orch2.env and adjust.
# Run: ./scripts/run-orchestrator.sh orch2

WALLET_NAME=beam-1
WALLET_HOTKEY=beam-1h
API_PORT=9003
READY=true

ORCH_GATEWAY_URL=tls://orch-gateway.b1m.ai:4222
CORE_SERVER_URL=https://beamcore.b1m.ai

# Embedded: workers run inside the orchestrator process (no separate worker WS).
WORKER_GATEWAY_MODE=embedded

# Cloudflare transfer (shared endpoint + per embedded worker enable):
#   WORKER_N_CF_TRANSFER_ENABLED=true|false  → per-worker (preferred)
#   CF_TRANSFER_ENABLED=true|false           → default when WORKER_N unset
# CF_TRANSFER_WORKER_URL=https://your-transfer-worker.workers.dev
# CF_TRANSFER_WORKER_TIMEOUT=120
# CF_TRANSFER_SEND_ACCEPT=true
# WORKER_1_CF_TRANSFER_ENABLED=true
# WORKER_2_CF_TRANSFER_ENABLED=false

WORKER_1=beam-w1:beam-w1h
WORKER_2=beam-w2:beam-w2h
# WORKER_1_MAX_CONCURRENT_TASKS=4
# WORKER_2_MAX_CONCURRENT_TASKS=4
# WORKER_MAX_CONCURRENT_TASKS=4

# Advertised gateway URL (must be reachable — not 127.0.0.1).
ORCHESTRATOR_WORKER_GATEWAY_URL=http://YOUR_PUBLIC_IP:9003

# -----------------------------------------------------------------------------
# Byte-range cache (set on orch env for embedded workers)
# hit → upload from range_data; miss → fetch/store/merge (≤1 GiB files)
# Local: logs/workers/predefined_etag_range_data/
# -----------------------------------------------------------------------------
WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
WORKER_PREDEFINED_ETAG_MAX_PARALLEL=2
WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
WORKER_PREDEFINED_ETAG_BOOTSTRAP_MAX_DOWNLOADS=0
# WORKER_PREDEFINED_ETAG_MAX_SPEED_MBPS=450
# WORKER_PREDEFINED_ETAG_MIN_SUBMIT_SEC=0

# Optional env hash/etag override for one source:
# WORKER_PREDEFINED_ETAG_SOURCE_URL=https://example.r2.cloudflarestorage.com/bucket/file.bin
# WORKER_PREDEFINED_ETAG_CHUNK_HASH=<sha256 hex>
# WORKER_PREDEFINED_ETAG_ETAG="etag-value"

# Shared control-server cache (optional; unset to disable):
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_URL=http://YOUR_CONTROL_SERVER:8010
# CONTROL_SERVER_SECRET=change-me-control-secret
# CONTROL_SERVER_MINER_ID=miner1
# CONTROL_SERVER_CACHE_SYNC_DELAY_SEC=150

# Prewarm skipped on predefined-etag path; disable for standard path too if desired:
WORKER_PREWARM_ENABLED=false

# RANGE_DATA_MAX_SEGMENT_BYTES=1073741824
