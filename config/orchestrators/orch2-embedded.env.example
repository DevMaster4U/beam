# Orchestrator with embedded workers (v0.2.0)
# Copy to orch2.env and adjust.
# Run: ./scripts/run-orchestrator.sh orch2

WALLET_NAME=beam-1
WALLET_HOTKEY=beam-1h
API_PORT=9003
READY=true

ORCH_GATEWAY_URL=https://orch-gateway.b1m.ai
CORE_SERVER_URL=https://beamcore.b1m.ai

# Embedded mode: workers run inside the orchestrator process (no separate worker WS)
WORKER_GATEWAY_MODE=embedded

# Embedded worker hotkeys (wallet:hotkey or separate vars)
WORKER_1=beam-w1:beam-w1h
WORKER_2=beam-w2:beam-w2h
# WORKER_1_WALLET_NAME=beam-w1
# WORKER_1_HOTKEY=beam-w1h
# WORKER_1_ORDER=0
# WORKER_1_MAX_CONCURRENT_TASKS=4

# Optional: advertised gateway URL (workers register via HTTP, not WS)
ORCHESTRATOR_WORKER_GATEWAY_URL=http://84.32.220.100:9015

ORCH_WS_REQUEST_TIMEOUT=15.0
ORCH_TASK_ACCEPT_TIMEOUT=8.0
ORCH_TASK_RESULT_TIMEOUT=30.0

# Predefined ETag fast path (embedded: set here, not in worker env)
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# WORKER_PREDEFINED_ETAG_SOURCE_URL=https://ef88e61230a7f9cdaa979b6268878856.r2.cloudflarestorage.com/beam-xfer-test/source/b1m_test
# WORKER_PREDEFINED_ETAG_SOURCE_FILE_SIZE=10737418240
# WORKER_PREDEFINED_ETAG_MAX_PARALLEL=1
