# Orchestrator instance 1 — global gateway mode example
# Copy relevant lines into orch1.env when using shared gateway.

WORKER_GATEWAY_MODE=global
# Public URL workers and BeamCore use (global gateway HTTP port)
ORCHESTRATOR_WORKER_GATEWAY_URL=http://84.32.220.100:8001
# Loopback/control URL orchestrators use to reach global gateway
GLOBAL_GATEWAY_URL=http://127.0.0.1:8001
ORCHESTRATOR_GATEWAY_SECRET=your-long-random-orchestrator-secret
WORKER_GATEWAY_SECRET=your-long-random-worker-secret
