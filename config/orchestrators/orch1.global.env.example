# Orchestrator — global gateway mode (standalone workers on shared gateway)
# Copy relevant lines into config/orchestrators/orch1.env

WALLET_NAME=beam-1
WALLET_HOTKEY=beam-1h
API_PORT=9000
READY=true

ORCH_GATEWAY_URL=https://orch-gateway.b1m.ai
CORE_SERVER_URL=https://beamcore.b1m.ai

# BeamCore advertises this URL for worker registration (public gateway HTTP port).
ORCHESTRATOR_WORKER_GATEWAY_URL=http://84.32.131.175:8005

WORKER_GATEWAY_MODE=global
# Orchestrator control WS to global gateway (loopback if colocated, else remote host).
GLOBAL_GATEWAY_URL=http://127.0.0.1:8005
# GLOBAL_GATEWAY_URL=ws://84.32.131.175:8005

# Must match config/global-gateway.env on the gateway host.
ORCHESTRATOR_GATEWAY_SECRET=ogs
WORKER_GATEWAY_SECRET=wgs

# Leave false unless gateway must validate BeamCore api_key on control WS.
# GLOBAL_GATEWAY_CONTROL_USE_API_KEY=false

ORCH_WS_REQUEST_TIMEOUT=15.0
ORCH_TASK_ACCEPT_TIMEOUT=8.0
ORCH_TASK_RESULT_TIMEOUT=30.0

# Predefined-etag fast path runs in standalone workers (config/workers/workerN.env),
# NOT in this orchestrator env. Each worker needs the same WORKER_PREDEFINED_ETAG_*
# and CONTROL_SERVER_* vars as embedded mode (see orch2-embedded.env.example).
