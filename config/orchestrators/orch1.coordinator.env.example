# Orchestrator — colocated pool coordinator (Phase 1 IPC)
# Copy relevant lines into orch*.env when gateway runs on the same host.

WORKER_GATEWAY_MODE=coordinator
# Public URL workers and BeamCore use (pool coordinator HTTP port)
ORCHESTRATOR_WORKER_GATEWAY_URL=http://84.32.220.100:8001
# Unix socket on same host (must match GATEWAY_IPC_SOCKET_PATH in global-gateway.env)
POOL_COORDINATOR_IPC=run/pool-coordinator.sock
ORCHESTRATOR_GATEWAY_SECRET=your-long-random-orchestrator-secret
WORKER_GATEWAY_SECRET=your-long-random-worker-secret
