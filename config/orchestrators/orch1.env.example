# Per-orchestrator settings for instance "orch1".
# Copy to config/orchestrators/orch1.env and adjust.

CORE_SERVER_URL=https://beamcore.b1m.ai
ORCH_GATEWAY_URL=https://orch-gateway.b1m.ai
SUBTENSOR_NETWORK=finney
NETUID=105

WALLET_NAME=orchestrator
WALLET_HOTKEY=default
API_PORT=9000

ORCHESTRATOR_WORKER_GATEWAY_URL=https://your-orchestrator.example.com
WORKER_GATEWAY_WORKER_SECRET=your-long-random-worker-secret
WORKER_GATEWAY_CONTROL_SECRET=your-long-random-control-secret

# Optional: skip slow subtensor bootstrap when UID is known
# ORCHESTRATOR_UID=123

READY=true
LOG_LEVEL=INFO
