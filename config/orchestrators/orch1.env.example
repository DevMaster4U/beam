# Orchestrator instance — copy to orch1.env and adjust.
# Run: ./scripts/run-orchestrator.sh orch1
#
# BeamCore decides how many offers you get (PRISM / owner-group). This file only
# configures local registration, gateway mode, and worker routing.

# =============================================================================
# Identity + BeamCore
# =============================================================================
WALLET_NAME=orchestrator
WALLET_HOTKEY=orch1
# WALLET_PATH=~/.bittensor/wallets
API_PORT=9000
READY=true
# Optional: skip subtensor metagraph lookup when UID is known
# ORCHESTRATOR_UID=42

ORCH_GATEWAY_URL=tls://orch-gateway.b1m.ai:4222
CORE_SERVER_URL=https://beamcore.b1m.ai
# REGION=US
# One-time BeamCore HTTP register (before first NATS connect):
#   ./scripts/register-orchestrator.sh orch1 --write-env
# BEAMCORE_ORCHESTRATOR_API_KEY=b1m_...


# =============================================================================
# Worker gateway mode
# =============================================================================
# in_process  — orch hosts /ws/{worker_id} on API_PORT (external workers connect)
# embedded    — workers run inside orch process (WORKER_1, WORKER_2, …)
# in_process  — can also combine with WORKER_N for hybrid (embedded + external)
# global      — forward batches to GLOBAL_GATEWAY_URL
# coordinator — pool coordinator IPC + shared gateway
#
# WORKER_GATEWAY_MODE=in_process

# Public origin advertised to BeamCore / workers (must be reachable).
# Do NOT use http://127.0.0.1 — workers and BeamCore need a real host.
ORCHESTRATOR_WORKER_GATEWAY_URL=https://your-orchestrator.example.com
WORKER_GATEWAY_SECRET=your-long-random-worker-secret

# global / coordinator only:
# GLOBAL_GATEWAY_URL=http://your-global-gateway:8005
# POOL_COORDINATOR_IPC=/tmp/beam-pool-coordinator.sock

# =============================================================================
# Embedded workers (WORKER_GATEWAY_MODE=embedded|in_process hybrid)
# =============================================================================
# WORKER_1=wallet:hotkey
# WORKER_2=wallet:hotkey
# WORKER_1_MAX_CONCURRENT_TASKS=4
# WORKER_MAX_CONCURRENT_TASKS=4

# =============================================================================
# Byte-range cache (embedded workers inherit these env vars)
# =============================================================================
# Same flow as external workers:
#   hit → slice from range_data → upload
#   miss → fetch/upload → ingest merge + pack ≤1 GiB
#
# For embedded mode, set cache vars HERE (not in worker env).
# External workers: set them in config/workers/<name>.env
#
# WORKER_PREDEFINED_ETAG_EARLY_SUBMIT=true
# WORKER_PREDEFINED_ETAG_MAX_PARALLEL=2
# WORKER_PREDEFINED_ETAG_AUTO_DOWNLOAD_CHUNKS=false
# WORKER_PREDEFINED_ETAG_BOOTSTRAP_MAX_DOWNLOADS=0
#
# Optional shared control-server (unset all to disable cache sync):
# CONTROL_SERVER_WS_URL=ws://YOUR_CONTROL_SERVER:8010/ws/miners
# CONTROL_SERVER_URL=http://YOUR_CONTROL_SERVER:8010
# CONTROL_SERVER_SECRET=change-me-control-secret
# CONTROL_SERVER_MINER_ID=miner1
#
# RANGE_DATA_MAX_SEGMENT_BYTES=1073741824

# MAX_WORKERS=10000
# Cap on concurrent external worker WebSocket sessions (WorkerGateway).
# ORCH_WORKER_GATEWAY_MAX_WORKERS=10
# Prefer idle workers for first-wave speed (default true). Second-batch overflow
# waits for a free worker instead of stacking onto a busy first-wave worker.
# ORCH_PREFER_IDLE_WORKERS=true
# ORCH_ALLOW_BUSY_WORKER_REUSE=false
# Hold undelivered offers and push when a worker frees (default true).
# ORCH_OVERFLOW_QUEUE_ENABLED=true
# ORCH_OVERFLOW_QUEUE_MAX=2000
# When overflow pending > threshold, stack onto busy workers (up to N each).
# ORCH_OVERFLOW_BUSY_THRESHOLD=100
# ORCH_OVERFLOW_BUSY_MAX_PER_WORKER=5
# Dest×worker avg Mbps affinity (survives orch restart via JSON file).
# On by default: store running avg Mbps per (dest_group, worker_id) and deliver
# each offer to the fastest free worker for that dest.
# ORCH_DEST_AFFINITY=true
# ORCH_DEST_AFFINITY_STATS_PATH=logs/orchestrators/dest_worker_stats.json
# ORCH_DEST_AFFINITY_SEED_CSV=
# Wipe affinity on process start (also: --clear-affinity / POST /workers/affinity/clear).
# ORCH_DEST_AFFINITY_CLEAR_ON_START=false
# LOG_LEVEL=INFO
# ORCH_RELAY_SLOW_LOG_MS=1000.0
# ORCH_BATCH_DETAIL_LOG=false
