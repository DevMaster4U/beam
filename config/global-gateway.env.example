# Global worker gateway — copy to config/global-gateway.env
# Run: ./scripts/run-global-gateway.sh start

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
CORE_SERVER_URL=https://beamcore.b1m.ai

# Workers connect with worker_secret; orchestrators use orchestrator_secret on control WS
WORKER_GATEWAY_SECRET=your-long-random-worker-secret
ORCHESTRATOR_GATEWAY_SECRET=your-long-random-orchestrator-secret

GATEWAY_MAX_WORKERS=100
# round_robin (default) or best_score
GATEWAY_WORKER_SELECTION=round_robin
LOG_LEVEL=INFO

# Phase 1: colocated orchestrators use unix socket (WORKER_GATEWAY_MODE=coordinator)
GATEWAY_IPC_ENABLED=true
GATEWAY_IPC_SOCKET_PATH=run/pool-coordinator.sock

# Hidden overflow workers connect with ?hidden=1 (no live BeamCore API key check)
GATEWAY_HIDDEN_WORKERS_ENABLED=true
