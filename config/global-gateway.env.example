# Global worker gateway — copy to config/global-gateway.env
# Run: ./scripts/run-global-gateway.sh

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
CORE_SERVER_URL=https://beamcore.b1m.ai

# Workers connect with worker_secret; orchestrators use orchestrator_secret on control WS
WORKER_GATEWAY_SECRET=your-long-random-worker-secret
ORCHESTRATOR_GATEWAY_SECRET=your-long-random-orchestrator-secret

GATEWAY_MAX_WORKERS=100
LOG_LEVEL=INFO
