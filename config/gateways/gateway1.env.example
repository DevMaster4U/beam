# Per-gateway settings for instance "gateway1".
# Copy to config/gateways/gateway1.env and adjust.
#
# Shared settings are loaded from the workspace .env unless overridden here.

GATEWAY_HOST=0.0.0.0
# Use a unique port per gateway instance on one host.
GATEWAY_PORT=8001

# Shared secret between orchestrator and gateway control channel
GATEWAY_CONTROL_SECRET=change-me-to-a-long-random-string

# Shared secret for authorized workers on this dedicated gateway
GATEWAY_WORKER_SECRET=change-me-to-a-different-long-random-string

LOG_LEVEL=INFO
GATEWAY_WS_PING_INTERVAL=30
GATEWAY_WS_PING_TIMEOUT=10
